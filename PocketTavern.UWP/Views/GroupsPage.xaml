<Page
    x:Class="PocketTavern.UWP.Views.GroupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PocketTavern.UWP.Controls"
    Background="{StaticResource BackgroundDeepBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{StaticResource BackgroundSurfaceBrush}" Padding="4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Background="Transparent" BorderThickness="0"
                    Click="BackButton_Click">
                <TextBlock Text="&#xE830;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </Button>
            <TextBlock Grid.Column="1" Text="Groups" VerticalAlignment="Center"
                       Style="{StaticResource TitleTextStyle}" />
            <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                    Click="NewGroupButton_Click" ToolTipService.ToolTip="New Group">
                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="{StaticResource AccentPrimaryBrush}" />
            </Button>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="16">

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Padding="24" Margin="0,60,0,0">
                    <TextBlock Text="&#xE902;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="No groups yet." Margin="0,12,0,0"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="Tap + to create a group chat with multiple characters."
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                </StackPanel>

                <!-- Group list -->
                <controls:SpacedPanel x:Name="GroupListPanel" Spacing="8" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
