<Page
    x:Class="PocketTavern.UWP.Views.CharacterBookPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BackgroundDeepBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{StaticResource BackgroundSurfaceBrush}" Padding="4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource TextPrimaryBrush}" Click="OnBackClick"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18" />
            </Button>
            <TextBlock Grid.Column="1" x:Name="TitleLabel" Text="Character Book"
                       Style="{StaticResource TitleTextStyle}"
                       VerticalAlignment="Center" Margin="4,0" />
            <Button Grid.Column="2" x:Name="AddEntryButton" Margin="0,0,8,0"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource AccentPrimaryBrush}" Click="OnAddEntryClick"
                    ToolTipService.ToolTip="Add entry">
                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="20" />
            </Button>
        </Grid>

        <!-- Entry list -->
        <ListView Grid.Row="1" x:Name="EntriesList"
                  SelectionMode="None" Background="Transparent" Padding="0,8,0,8"
                  IsItemClickEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="16,4" Background="{StaticResource BackgroundCardBrush}"
                            CornerRadius="12" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DisplayKeys}"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           FontSize="12" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource AccentPrimaryBrush}"
                                    Margin="4,0" Click="OnEditEntryClick" Tag="{Binding}">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            </Button>
                            <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                                    Foreground="#E05252" Click="OnDeleteEntryClick" Tag="{Binding}">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" Grid.Row="1" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&#xE736;" FontFamily="Segoe MDL2 Assets" FontSize="64"
                       HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="No embedded lore entries"
                       Style="{StaticResource SubtitleTextStyle}"
                       HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="16" />
            <TextBlock Text="Tap + to add the first entry"
                       Style="{StaticResource SubtitleTextStyle}"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</Page>
