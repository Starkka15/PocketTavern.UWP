<Page
    x:Class="PocketTavern.UWP.Views.ExtensionPanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BackgroundDeepBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{StaticResource BackgroundSurfaceBrush}" Padding="4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource TextPrimaryBrush}" Click="OnBackClick"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18" />
            </Button>
            <TextBlock x:Name="PageTitle" Grid.Column="1" Text="Extension"
                       Style="{StaticResource TitleTextStyle}"
                       VerticalAlignment="Center" Margin="4,0" />
            <Button x:Name="ReloadBtn" Grid.Column="2" Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource AccentPrimaryBrush}"
                    Click="OnReloadClick" Padding="8,4" Visibility="Collapsed"
                    ToolTipService.ToolTip="Reload panel">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="18" />
            </Button>
        </Grid>

        <!-- WebView panel -->
        <WebView x:Name="PanelWebView" Grid.Row="1" Visibility="Collapsed"
                 ScriptNotify="OnScriptNotify" />

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" Grid.Row="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Visible">
            <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="No panel available" FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock x:Name="EmptySubtext" Text="This extension does not provide a panel UI."
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</Page>
