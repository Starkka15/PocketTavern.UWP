<Page
    x:Class="PocketTavern.UWP.Views.GroupChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PocketTavern.UWP.Controls"
    Background="{StaticResource BackgroundDeepBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{StaticResource BackgroundSurfaceBrush}" Padding="4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Background="Transparent" BorderThickness="0"
                    Click="BackButton_Click">
                <TextBlock Text="&#xE830;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </Button>
            <TextBlock Grid.Column="1" x:Name="GroupNameLabel" Text="Group Chat"
                       VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
            <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                    Padding="8,4" Click="SettingsButton_Click"
                    ToolTipService.ToolTip="Group Settings">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </Button>
            <Button Grid.Column="3" Background="Transparent" BorderThickness="0"
                    Padding="8,4" Click="NewChatButton_Click"
                    ToolTipService.ToolTip="New Chat">
                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </Button>
        </Grid>

        <!-- Member chips -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Background="{StaticResource BackgroundSurfaceBrush}"
                      Padding="12,4">
            <StackPanel x:Name="MemberChipsPanel" Orientation="Horizontal" />
        </ScrollViewer>

        <!-- Empty state / first message prompt -->
        <Grid Grid.Row="2" x:Name="EmptyStatePanel" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No messages yet" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"
                           Margin="0,0,0,12" />
                <Button x:Name="GenerateFirstMsgButton"
                        HorizontalAlignment="Center"
                        Background="{StaticResource AccentPrimaryBrush}"
                        Foreground="White" Padding="16,8"
                        Click="GenerateFirstMsgButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Generate first message" FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Messages -->
        <ListView Grid.Row="2" x:Name="MessagesList"
                  SelectionMode="None"
                  Background="Transparent"
                  Padding="8,4"
                  ItemContainerStyle="{StaticResource MessageListItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,6">
                        <!-- AI/character message: left -->
                        <StackPanel HorizontalAlignment="Left" MaxWidth="300"
                                    Visibility="{Binding IsUser, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding SenderName}"
                                       Style="{StaticResource SubtitleTextStyle}"
                                       FontSize="11" Margin="4,0,0,2"
                                       Foreground="{StaticResource AccentPrimaryBrush}" />
                            <Border Background="{StaticResource AiBubbleBrush}"
                                    CornerRadius="4,12,12,12" Padding="12,10">
                                <controls:MarkdownTextBlock Text="{Binding Content}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextFontSize="14" />
                            </Border>
                        </StackPanel>
                        <!-- User message: right -->
                        <StackPanel HorizontalAlignment="Right" MaxWidth="300"
                                    Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding SenderName}"
                                       Style="{StaticResource SubtitleTextStyle}"
                                       FontSize="11" HorizontalAlignment="Right"
                                       Margin="0,0,4,2" />
                            <Border Background="{StaticResource UserBubbleBrush}"
                                    CornerRadius="12,4,12,12" Padding="12,10">
                                <controls:MarkdownTextBlock Text="{Binding Content}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextFontSize="14" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Generating indicator -->
        <Border Grid.Row="3" x:Name="SpeakerBar" Visibility="Collapsed"
                Background="{StaticResource BackgroundSurfaceBrush}" Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <ProgressRing IsActive="True" Width="16" Height="16"
                              Foreground="{StaticResource AccentPrimaryBrush}" />
                <TextBlock x:Name="SpeakerLabel" FontSize="12"
                           Foreground="{StaticResource AccentPrimaryBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Input bar -->
        <Grid Grid.Row="4" Background="{StaticResource BackgroundSurfaceBrush}" Padding="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="InputBox"
                     PlaceholderText="Message the group…"
                     TextWrapping="Wrap" MaxHeight="120"
                     AcceptsReturn="False"
                     TextChanged="InputBox_TextChanged"
                     KeyDown="InputBox_KeyDown" />
            <Button Grid.Column="1" x:Name="StopButton" Content="&#xE71A;"
                    FontFamily="Segoe MDL2 Assets" FontSize="20"
                    Background="Transparent" BorderThickness="0"
                    Visibility="Collapsed"
                    Click="StopButton_Click" Margin="4,0,0,0" />
            <Button Grid.Column="2" x:Name="SendButton" Content="&#xE724;"
                    FontFamily="Segoe MDL2 Assets" FontSize="20"
                    Background="Transparent" BorderThickness="0"
                    Click="SendButton_Click" Margin="4,0,0,0" />
        </Grid>
    </Grid>
</Page>
