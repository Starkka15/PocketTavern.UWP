<Page
    x:Class="PocketTavern.UWP.Views.ThemeBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BackgroundDeepBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{StaticResource BackgroundSurfaceBrush}" Padding="4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource TextPrimaryBrush}" Click="OnBackClick"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18" />
            </Button>
            <TextBlock Grid.Column="1" Text="Create Theme"
                       Style="{StaticResource TitleTextStyle}"
                       VerticalAlignment="Center" Margin="4,0" />
            <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource AccentPrimaryBrush}"
                    Click="OnSaveClick" Padding="8,4"
                    ToolTipService.ToolTip="Save theme">
                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="18" />
            </Button>
        </Grid>

        <!-- Scrollable form -->
        <ScrollViewer Grid.Row="1" Padding="16">
            <StackPanel>

                <!-- Theme name -->
                <TextBox x:Name="ThemeNameBox" Header="Theme name"
                         PlaceholderText="my_custom_theme"
                         Style="{StaticResource DarkTextBoxStyle}" />
                <Rectangle Height="12" Fill="Transparent" />

                <!-- Color preview strip -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border x:Name="SwatchDeep" Width="32" Height="32" CornerRadius="16" Margin="0,0,4,0" />
                    <Border x:Name="SwatchSurface" Width="32" Height="32" CornerRadius="16" Margin="0,0,4,0" />
                    <Border x:Name="SwatchCard" Width="32" Height="32" CornerRadius="16" Margin="0,0,4,0" />
                    <Border x:Name="SwatchAccent" Width="32" Height="32" CornerRadius="16" Margin="0,0,4,0" />
                    <Border x:Name="SwatchTextPri" Width="32" Height="32" CornerRadius="16" Margin="0,0,4,0" />
                    <Border x:Name="SwatchTextSec" Width="32" Height="32" CornerRadius="16" Margin="0,0,4,0" />
                    <Border x:Name="SwatchUserBubble" Width="32" Height="32" CornerRadius="16" Margin="0,0,4,0" />
                    <Border x:Name="SwatchAiBubble" Width="32" Height="32" CornerRadius="16" />
                </StackPanel>

                <!-- Color field selector -->
                <Border Background="{StaticResource BackgroundCardBrush}" CornerRadius="12" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Color field"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" Margin="0,0,0,6" />
                        <ListView x:Name="ColorFieldList" SelectionMode="Single"
                                  Background="Transparent"
                                  SelectionChanged="OnFieldSelectionChanged">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" CornerRadius="6"
                                            Background="{StaticResource BackgroundSurfaceBrush}">
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="13" />
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Rectangle Height="8" Fill="Transparent" />

                <!-- RGB sliders -->
                <Border Background="{StaticResource BackgroundCardBrush}" CornerRadius="12" Padding="16,12">
                    <StackPanel>
                        <TextBlock x:Name="CurrentFieldLabel" Text="Background (deep)"
                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Slider x:Name="RedSlider" Header="R" Minimum="0" Maximum="255"
                                ValueChanged="OnSliderChanged" />
                        <Slider x:Name="GreenSlider" Header="G" Minimum="0" Maximum="255"
                                ValueChanged="OnSliderChanged" />
                        <Slider x:Name="BlueSlider" Header="B" Minimum="0" Maximum="255"
                                ValueChanged="OnSliderChanged" />
                        <Slider x:Name="AlphaSlider" Header="A" Minimum="0" Maximum="255"
                                Value="255" ValueChanged="OnSliderChanged" />
                    </StackPanel>
                </Border>

                <Rectangle Height="24" Fill="Transparent" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
