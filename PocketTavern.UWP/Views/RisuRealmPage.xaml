<Page
    x:Class="PocketTavern.UWP.Views.RisuRealmPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BackgroundDeepBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{StaticResource BackgroundSurfaceBrush}" Padding="4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource TextPrimaryBrush}" Click="OnBackClick"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18" />
            </Button>
            <TextBlock Grid.Column="1" Text="RisuRealm"
                       Style="{StaticResource TitleTextStyle}"
                       VerticalAlignment="Center" Margin="4,0" />
            <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Click="OnRefreshClick"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    ToolTipService.ToolTip="Reload">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="18" />
            </Button>
        </Grid>

        <!-- WebView -->
        <WebView Grid.Row="1" x:Name="RealmWebView"
                 NavigationStarting="OnNavigationStarting"
                 UnviewableContentIdentified="OnUnviewableContent"
                 NewWindowRequested="OnNewWindowRequested" />

        <!-- Import status bar -->
        <Border Grid.Row="2" x:Name="ImportStatusBar"
                Background="{StaticResource BackgroundSurfaceBrush}"
                Padding="16,8" Visibility="Collapsed">
            <TextBlock x:Name="ImportStatusText"
                       Style="{StaticResource SubtitleTextStyle}"
                       HorizontalAlignment="Center" />
        </Border>
    </Grid>
</Page>
