<Page
    x:Class="PocketTavern.UWP.Views.BackupExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PocketTavern.UWP.Controls"
    Background="{StaticResource BackgroundDeepBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{StaticResource BackgroundSurfaceBrush}" Padding="4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Background="Transparent" BorderThickness="0"
                    Click="BackButton_Click">
                <TextBlock Text="&#xE830;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </Button>
            <TextBlock Grid.Column="1" Text="Export Data" VerticalAlignment="Center"
                       Style="{StaticResource TitleTextStyle}" />
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="16">
                <controls:SpacedPanel Spacing="16">

                    <TextBlock Text="Backup your PocketTavern data as a SillyTavern-compatible ZIP archive."
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />

                    <TextBlock Text="The archive will contain your characters, lorebooks, and chat history."
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />

                    <Button x:Name="ExportButton" Content="Select Location and Export"
                            HorizontalAlignment="Stretch" Click="ExportButton_Click"
                            Style="{StaticResource AccentButtonStyle}" />

                    <!-- Progress -->
                    <Border x:Name="ProgressPanel" Visibility="Collapsed"
                            Background="{StaticResource BackgroundSurfaceBrush}"
                            CornerRadius="8" Padding="12">
                        <controls:SpacedPanel Spacing="8">
                            <ProgressBar IsIndeterminate="True" />
                            <TextBlock Text="Exporting…"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </controls:SpacedPanel>
                    </Border>

                    <!-- Results -->
                    <Border x:Name="ResultsPanel" Visibility="Collapsed"
                            Background="{StaticResource BackgroundSurfaceBrush}"
                            CornerRadius="8" Padding="12">
                        <controls:SpacedPanel Spacing="4">
                            <TextBlock Text="Export Complete"
                                       Style="{StaticResource SubtitleTextStyle}" />
                            <TextBlock x:Name="ResultsText" TextWrapping="Wrap" />
                        </controls:SpacedPanel>
                    </Border>

                </controls:SpacedPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
